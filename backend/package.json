{
  "name": "carenex-backend",
  "version": "1.0.0",
  "description": "CareNex Smart Healthcare Appointment & Patient Management System API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
