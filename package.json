{
  "name": "carenex-monorepo",
  "version": "1.0.0",
  "description": "CareNex – Smart Healthcare Appointment & Patient Management System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "db:seed": "npm --prefix backend run db:seed",
    "db:seed:small": "npm --prefix backend run db:seed:small",
    "db:seed:full": "npm --prefix backend run db:seed:full",
    "test": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
